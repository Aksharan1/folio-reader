{
  "name": "folio-reader",
  "productName": "Folio",
  "version": "1.0.0",
  "description": "A fast, private EPUB reader for your desktop and browser.",
  "author": "Aksharan",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "keywords": [
    "epub",
    "ebook",
    "reader",
    "epubjs",
    "indexeddb",
    "offline"
  ],
  "scripts": {
    "start": "node scripts/serve.mjs",
    "app": "electron .",
    "dist": "electron-builder --win",
    "test": "node tests/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "vendor": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/epubjs/dist/epub.min.js','vendor/epub.min.js');fs.copyFileSync('node_modules/jszip/dist/jszip.min.js','vendor/jszip.min.js');console.log('vendor/ updated')\"",
    "icon": "node scripts/icon.mjs"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "puppeteer": "^25.12.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.aksharan.folio",
    "productName": "Folio",
    "files": [
      "index.html",
      "app.css",
      "js/**",
      "vendor/**",
      "samples/**",
      "electron/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "description": "EPUB e-book",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Folio-Setup-${version}.${ext}"
    }
  }
}
