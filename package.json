{
  "name": "folio-reader",
  "productName": "Folio",
  "version": "1.3.0",
  "description": "A fast, private e-book and manga reader for Windows, macOS and Linux. EPUB, Kindle, PDF, comics (CBZ, CBR), FB2, Word, Markdown and text.",
  "author": "Aksharan",
  "homepage": "https://github.com/Aksharan1/folio-reader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aksharan1/folio-reader.git"
  },
  "bugs": {
    "url": "https://github.com/Aksharan1/folio-reader/issues"
  },
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "keywords": [
    "ebook",
    "ebook-reader",
    "epub",
    "mobi",
    "azw3",
    "fb2",
    "pdf",
    "manga",
    "comics",
    "cbz",
    "cbr",
    "reader",
    "electron",
    "windows",
    "macos",
    "linux",
    "offline",
    "privacy"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node tests/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "vendor": "node scripts/vendor.mjs",
    "icon": "node scripts/icon.mjs",
    "dmg-background": "node scripts/dmg-background.mjs"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "epubjs": "^0.3.93",
    "foliate-js": "^1.0.1",
    "jszip": "^3.10.2",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "puppeteer": "^25.12.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "build": {
    "appId": "com.aksharan.folio",
    "productName": "Folio",
    "files": [
      "index.html",
      "app.css",
      "js/**",
      "vendor/**",
      "samples/**",
      "electron/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "description": "EPUB e-book",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": [
          "mobi",
          "azw",
          "azw3",
          "prc"
        ],
        "name": "Kindle Book",
        "description": "Kindle e-book",
        "role": "Viewer"
      },
      {
        "ext": [
          "fb2",
          "fbz"
        ],
        "name": "FictionBook",
        "description": "FictionBook e-book",
        "role": "Viewer"
      },
      {
        "ext": [
          "cbz",
          "cbr",
          "cbt"
        ],
        "name": "Comic Book",
        "description": "Comic book archive",
        "role": "Viewer"
      }
    ],
    "portable": {
      "artifactName": "Folio-Portable-Windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Folio-Setup-Windows.${ext}"
    },
    "mac": {
      "category": "public.app-category.books",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Folio-macOS.${ext}",
      "files": [
        "index.html",
        "app.css",
        "js/**",
        "vendor/**",
        "samples/**",
        "electron/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/{win32,linux}/**"
      ]
    },
    "dmg": {
      "title": "Folio",
      "background": "build/dmg-background.png",
      "iconSize": 112,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "category": "Office",
      "synopsis": "A fast, private e-book and manga reader",
      "maintainer": "Aksharan <110070846+Aksharan1@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Folio-Linux.${ext}",
      "mimeTypes": [
        "application/epub+zip",
        "application/x-mobipocket-ebook",
        "application/vnd.comicbook+zip",
        "application/vnd.comicbook-rar",
        "application/x-fictionbook+xml",
        "application/pdf"
      ],
      "files": [
        "index.html",
        "app.css",
        "js/**",
        "vendor/**",
        "samples/**",
        "electron/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/{darwin,win32}/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/arm64/**"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "files": [
        "index.html",
        "app.css",
        "js/**",
        "vendor/**",
        "samples/**",
        "electron/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/{darwin,linux}/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
      ]
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ]
  },
  "dependencies": {
    "onnxruntime-node": "1.21.0",
    "phonemizer": "1.2.1"
  }
}
