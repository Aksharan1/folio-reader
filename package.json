{
  "name": "folio-reader",
  "productName": "Folio",
  "version": "1.0.0",
  "description": "A fast, private e-book reader for Windows.",
  "author": "Aksharan",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "keywords": [
    "epub",
    "ebook",
    "mobi",
    "azw3",
    "fb2",
    "pdf",
    "reader",
    "epubjs",
    "indexeddb",
    "offline"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node tests/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "vendor": "node scripts/vendor.mjs",
    "icon": "node scripts/icon.mjs"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "epubjs": "^0.3.93",
    "foliate-js": "^1.0.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "puppeteer": "^25.12.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.aksharan.folio",
    "productName": "Folio",
    "files": [
      "index.html",
      "app.css",
      "js/**",
      "vendor/**",
      "samples/**",
      "electron/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "description": "EPUB e-book",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": [
          "mobi",
          "azw",
          "azw3",
          "prc"
        ],
        "name": "Kindle Book",
        "description": "Kindle e-book",
        "role": "Viewer"
      },
      {
        "ext": [
          "fb2",
          "fbz"
        ],
        "name": "FictionBook",
        "description": "FictionBook e-book",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Folio-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Folio-Setup-${version}.${ext}"
    }
  }
}
